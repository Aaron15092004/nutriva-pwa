# ===== Database =====
# Chuỗi kết nối MongoDB Atlas — xem hướng dẫn chi tiết ở docs/MONGODB_ATLAS.md
# Ví dụ: mongodb+srv://nutriva_app:<password>@cluster0.xxxxx.mongodb.net/nutriva?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# ===== Bảo mật =====
# Chuỗi bí mật ký JWT. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email được tự động cấp quyền admin (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=

# ===== Đăng nhập Google (tùy chọn) =====
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (loại "Web application").
# Authorized JavaScript origins: http://localhost:5173, https://<tên-app>.onrender.com
# Để trống: ẩn nút "Tiếp tục với Google".
GOOGLE_CLIENT_ID=

# ===== Trợ lý NUTRIVA (Claude API) =====
# Lấy key tại https://console.anthropic.com → API Keys. Để trống: trợ lý trả lời theo từ khóa.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ===== Web Push (nhắc nhở) =====
# Để trống: server tự tạo khóa VAPID và lưu vào DB. Tạo thủ công: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nguyenmanhhuynh15092004@gmail.com

# ===== Khác =====
PORT=5000
APP_TZ=Asia/Ho_Chi_Minh
# Origin frontend khi deploy tách rời (nhiều origin cách nhau bởi dấu phẩy)
CLIENT_ORIGIN=http://localhost:5173
# Bộ lập lịch an toàn khi chạy nhiều server (nhắc nhở/gói định kỳ được "giữ chỗ" nguyên tử). Tắt hẳn: SCHEDULER=off
# SCHEDULER=off

# ===== Email (quên mật khẩu) =====
# Lấy key tại https://resend.com (miễn phí 3.000 mail/tháng). Để trống: link đặt lại mật khẩu chỉ in ra log server.
RESEND_API_KEY=
# Người gửi (domain đã xác minh trên Resend). Mặc định: NUTRIVA <onboarding@resend.dev>
# MAIL_FROM=NUTRIVA <no-reply@ten-mien-cua-ban.vn>
# Địa chỉ app dùng trong link email. Render tự có RENDER_EXTERNAL_URL nên thường không cần đặt.
# APP_URL=https://nutriva.onrender.com

# ===== Cron bên ngoài (Render gói miễn phí ngủ sau 15 phút không có truy cập) =====
# Tạo chuỗi bí mật bất kỳ, rồi tạo job trên https://cron-job.org gọi mỗi 5 phút:
#   POST https://<tên-app>.onrender.com/api/cron/tick   Header: Authorization: Bearer <CRON_SECRET>
# → nhắc nhở & đơn gói định kỳ chạy đúng giờ, server không bị ngủ.
CRON_SECRET=
